# ==============================================================================
# TOTAL TRIGO (4S ERP) - VARIÁVEIS DE AMBIENTE DO BACKEND (PRODUÇÃO)
# ==============================================================================

# Porta do servidor HTTP (Cloud Run e Railway injetam automaticamente)
PORT=8085

# Perfil ativo do Spring Boot ("prod" ativa o application-prod.yml e desativa o H2 Console)
SPRING_PROFILES_ACTIVE=prod

# Conexão JDBC com o PostgreSQL na Nuvem (Neon.tech, Supabase ou Cloud SQL)
# Importante: A string deve começar com "jdbc:postgresql://"
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-exemplo-123456.sa-east-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=sua_senha_secreta_do_banco

# Client ID OAuth 2.0 do Google Cloud Console para validação de Login com Gmail (SSO)
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Domínios autorizados no CORS (separados por vírgula, sem barra no final)
CORS_ALLOWED_ORIGINS=https://totaltrigo.vercel.app,http://localhost:5173
